#!/bin/sh
# configure -- detect build environment for hpux-bc and write config.mk
#
# Usage:
#   ./configure [--prefix=DIR] [--cc=PATH] [--ar=PATH] [--ranlib=PATH]
#
# Outputs:
#   config.mk  -- included by Makefile; overrides CC, AR, RANLIB, PREFIX
#
# Typical use on HP-UX 11i V1:
#   chmod +x configure
#   ./configure --prefix=/usr/local
#   gmake
#   gmake install

# --------------------------------------------------------------------------
# Defaults
# --------------------------------------------------------------------------
# Default PREFIX: use /usr/local/pa11_32 if it exists and is writable
# (common HP-UX porting-centre layout), otherwise fall back to /usr/local.
if [ -d /usr/local/pa11_32 ] && [ -w /usr/local/pa11_32 ]; then
    PREFIX=/usr/local/pa11_32
elif [ -w /usr/local ]; then
    PREFIX=/usr/local
else
    PREFIX=$HOME/local
fi
CC_OVERRIDE=
AR_OVERRIDE=
RANLIB_OVERRIDE=

# --------------------------------------------------------------------------
# Argument parsing
# --------------------------------------------------------------------------
for arg in "$@"; do
    case "$arg" in
        --prefix=*)   PREFIX="${arg#*=}"   ;;
        --cc=*)       CC_OVERRIDE="${arg#*=}" ;;
        --ar=*)       AR_OVERRIDE="${arg#*=}" ;;
        --ranlib=*)   RANLIB_OVERRIDE="${arg#*=}" ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo ""
            echo "Options:"
            echo "  --prefix=DIR       Install into DIR (default: /usr/local)"
            echo "  --cc=PATH          C compiler to use (default: auto-detect gcc)"
            echo "  --ar=PATH          Archiver to use  (default: auto-detect ar)"
            echo "  --ranlib=PATH      ranlib to use    (default: auto-detect ranlib)"
            echo ""
            echo "After configure, build with:"
            echo "  gmake"
            echo "  gmake install"
            exit 0
            ;;
        *)
            echo "configure: unknown option: $arg" >&2
            echo "Run './configure --help' for usage." >&2
            exit 1
            ;;
    esac
done

# --------------------------------------------------------------------------
# Helper: find a program in well-known locations on HP-UX
# Search order: explicit --cc override, then PATH, then common depot dirs.
# --------------------------------------------------------------------------
find_prog() {
    prog="$1"
    override="$2"

    # If caller gave an explicit path, verify it exists and is executable.
    if [ -n "$override" ]; then
        if [ -x "$override" ]; then
            echo "$override"
            return 0
        else
            echo "configure: --${prog} path '$override' not found or not executable" >&2
            exit 1
        fi
    fi

    # Try PATH first (handles the common case where the user has it set up).
    result=$(command -v "$prog" 2>/dev/null)
    if [ -n "$result" ] && [ -x "$result" ]; then
        echo "$result"
        return 0
    fi

    # Common HP-UX depot/porting-centre installation directories.
    for dir in \
        /usr/local/bin \
        /opt/gcc42/bin \
        /opt/gcc/bin \
        /opt/gnu/bin \
        /usr/contrib/bin \
        /usr/bin
    do
        if [ -x "$dir/$prog" ]; then
            echo "$dir/$prog"
            return 0
        fi
    done

    # Not found -- return the bare name and let make fail with a clear message.
    echo "$prog"
    return 1
}

# --------------------------------------------------------------------------
# Detect tools
# --------------------------------------------------------------------------
printf "checking for gcc ... "
CC=$(find_prog gcc "$CC_OVERRIDE")
echo "$CC"

printf "checking for ar ... "
AR=$(find_prog ar "$AR_OVERRIDE")
echo "$AR"

printf "checking for ranlib ... "
RANLIB=$(find_prog ranlib "$RANLIB_OVERRIDE")
echo "$RANLIB"

# --------------------------------------------------------------------------
# Write config.mk
# --------------------------------------------------------------------------
cat > config.mk << EOF
# config.mk -- generated by ./configure on $(date)
# Do not edit by hand; re-run ./configure to regenerate.

CC      = $CC
AR      = $AR
RANLIB  = $RANLIB
PREFIX  = $PREFIX
EOF

echo ""
echo "configure: wrote config.mk"
echo ""
echo "  CC      = $CC"
echo "  AR      = $AR"
echo "  RANLIB  = $RANLIB"
echo "  PREFIX  = $PREFIX"
echo ""
echo "Now run:  gmake"
echo "Then:     gmake install"

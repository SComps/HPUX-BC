# Makefile for HP-UX BASIC Compiler (bcc) and Runtime (libbasic.a)
# Tested with gmake on HP-UX 11i V1 PA-RISC; also works with GNU make elsewhere.
#
# DEVELOPMENT ENVIRONMENT NOTE:
#   Source code is authored on Windows (Visual Studio 2026 / MSVC environment).
#   This Makefile is NOT run on the authoring machine -- there is no gcc on it.
#   Upload the source tree to HP-UX, then run:
#       ./configure           (detects gcc, ar, ranlib; writes config.mk)
#       gmake                 (or: make)
#   Requires: gcc 4.2+, ar, ranlib, gmake.
#
# Compiler flags: C89, all warnings, pedantic.
# Runtime flags:  same but optimised with -O2.
#
# Install layout (PREFIX=/usr/local by default):
#   $(PREFIX)/bin/bcc                  -- the compiler driver
#   $(PREFIX)/lib/libbasic.a           -- the runtime static library
#   $(PREFIX)/include/basic_runtime.h  -- the runtime header
#
# After install, bcc finds the runtime via $PREFIX/lib since that dir
# contains both basic_runtime.h and libbasic.a.  You can override with
# the BCCRUNTIME environment variable.

# ------------------------------------------------------------------
# config.mk is generated by ./configure.
# If it does not exist, tell the user what to do.
# ------------------------------------------------------------------
ifeq ($(wildcard config.mk),)
$(error config.mk not found -- please run: sh configure)
endif
include config.mk

# ------------------------------------------------------------------
# Build flags (not overridden by config.mk)
# ------------------------------------------------------------------
CFLAGS  = -Wall -Wextra -pedantic -std=c89 -O2

# ------------------------------------------------------------------
# Source lists
# ------------------------------------------------------------------
COMPILER_SRCS = \
    compiler/main.c \
    compiler/lexer.c \
    compiler/parser.c \
    compiler/ast.c \
    compiler/symtab.c \
    compiler/typesys.c \
    compiler/emitter.c \
    compiler/error.c

RUNTIME_SRCS = \
    runtime/basic_runtime.c \
    runtime/basic_string.c \
    runtime/basic_io.c \
    runtime/basic_file.c \
    runtime/basic_math.c \
    runtime/basic_error.c \
    runtime/basic_array.c \
    runtime/basic_lprint.c \
    runtime/basic_shell.c

COMPILER_OBJS = $(COMPILER_SRCS:.c=.o)
RUNTIME_OBJS  = $(RUNTIME_SRCS:.c=.o)

# Dependency files for incremental builds
DEPS = $(COMPILER_OBJS:.o=.d) $(RUNTIME_OBJS:.o=.d)

# Name of the distribution tarball and SD-UX depot
DISTNAME = hpux-basic-compiler
DISTVER  = 1.0
TARBALL  = $(DISTNAME)-$(DISTVER).tar.gz
DEPOT    = hpux-bc-$(DISTVER).depot

# ------------------------------------------------------------------
# Targets
# ------------------------------------------------------------------
.PHONY: all clean distclean install uninstall test dist depot ide

all: bcc libbasic.a

bcc: $(COMPILER_OBJS)
	$(CC) $(CFLAGS) -o $@ $(COMPILER_OBJS)

libbasic.a: $(RUNTIME_OBJS)
	$(AR) crs $@ $(RUNTIME_OBJS)
	$(RANLIB) $@

# ------------------------------------------------------------------
# Generic compilation rules with dependency generation
# ------------------------------------------------------------------
compiler/%.o: compiler/%.c
	$(CC) $(CFLAGS) -DBCC_PREFIX="\"$(PREFIX)\"" -MMD -MP -I compiler -c $< -o $@

runtime/%.o: runtime/%.c
	$(CC) $(CFLAGS) -MMD -MP -I runtime -c $< -o $@

# ------------------------------------------------------------------
# Test target -- compile and run each .bas test
# ------------------------------------------------------------------
test: bcc libbasic.a
	@echo "Running tests..."
	@if [ -f tests/run_tests.sh ]; then \
	    sh tests/run_tests.sh ./bcc; \
	else \
	    echo "No test runner yet."; \
	fi

# ------------------------------------------------------------------
# Install target
# ------------------------------------------------------------------
install: bcc libbasic.a
	mkdir -p $(PREFIX)/bin $(PREFIX)/lib $(PREFIX)/include
	cp bcc                     $(PREFIX)/bin/bcc
	chmod 755                  $(PREFIX)/bin/bcc
	cp libbasic.a              $(PREFIX)/lib/libbasic.a
	chmod 644                  $(PREFIX)/lib/libbasic.a
	cp runtime/basic_runtime.h $(PREFIX)/include/basic_runtime.h
	chmod 644                  $(PREFIX)/include/basic_runtime.h
	@echo "Installed bcc to $(PREFIX)/bin"
	@echo "Installed libbasic.a to $(PREFIX)/lib"
	@echo "Installed basic_runtime.h to $(PREFIX)/include"
	@echo ""
	@echo "To compile a BASIC program:  bcc hello.bas"
	@echo "To build and install the IDE: cd ide && make && make install"
	@echo ""
	@echo "If bcc cannot find the runtime, set:"
	@echo "  export BCCRUNTIME=$(PREFIX)/lib"

# ------------------------------------------------------------------
# Uninstall target
# ------------------------------------------------------------------
uninstall:
	rm -f $(PREFIX)/bin/bcc
	rm -f $(PREFIX)/lib/libbasic.a
	rm -f $(PREFIX)/include/basic_runtime.h

# ------------------------------------------------------------------
# Distribution tarball (optional)
# ------------------------------------------------------------------
dist:
	tar czf $(TARBALL) \
	    --exclude='*.o' --exclude='*.d' --exclude='*.a' \
	    --exclude='bcc' --exclude='$(TARBALL)' --exclude='backups' \
	    .
	@echo "Created $(TARBALL)"

# ------------------------------------------------------------------
# Build IDE and SD-UX .depot installer package
# ------------------------------------------------------------------
ide/bcc-ide: bcc libbasic.a ide/ide.bas
	$(MAKE) -C ide BCC=../bcc

depot: bcc libbasic.a ide/bcc-ide
	sh packaging/make_depot.sh "$(PREFIX)" "$(DISTVER)" "$(DEPOT)"

# ------------------------------------------------------------------
# Clean
# ------------------------------------------------------------------
clean:
	rm -f $(COMPILER_OBJS) $(RUNTIME_OBJS) $(DEPS) bcc libbasic.a $(DEPOT) packaging/hpux-bc.psf.gen
	$(MAKE) -C ide clean

distclean: clean
	rm -f config.mk

# Pull in auto-generated dependency files if they exist
-include $(DEPS)

# ------------------------------------------------------------------
# Regenerate config.mk if configure is newer (optional convenience)
# ------------------------------------------------------------------
config.mk: configure
	@echo "configure has changed -- re-running ./configure"
	@sh configure
